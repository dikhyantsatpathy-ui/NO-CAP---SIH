# ============================================================
# SSB Border Screening - SIH26188: AI-Based Fake Identity &
# Document Screening - Environment Template
# Copy to `.env`, fill in real values, and NEVER commit `.env`.
# ============================================================

# Neon Postgres (or any SQLAlchemy-compatible DB)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DB?sslmode=require

# Master key for the session-security HMAC (login cookies / dossier seals).
# WARNING: Changing this invalidates existing session cookies and dossier seals.
MASTER_VAULT_KEY=

# Google OAuth 2.0 Client ID used to authenticate screening officers
GOOGLE_CLIENT_ID=

# --- Who may log in (authorization gate). Driven by Google Cloud itself,
#     NOT a hardcoded list in code. ---
# Comma-separated domains, matches BOTH the id_token `hd` claim (Google
# Workspace) AND the email's own "@domain" suffix. Anyone whose account is in
# one of these domains is allowed automatically — add/remove people in Google
# Cloud (Workspace) and they get in with no code change. This is the ONLY way
# gmail-style accounts are "auto-enabled" (they have no hd claim), and it is
# NOT set here so NOT every gmail account can log in:
ALLOWED_DOMAINS=
# Comma-separated exact emails allowed to log in (your vetted allowlist).
# Anyone NOT a super admin AND NOT in ALLOWED_EMAILS/ALLOWED_DOMAINS is
# rejected with a 401 at login:
# ALLOWED_EMAILS=person@gmail.com,other@gmail.com
# Comma-separated super admins (override). When set, ONLY these bypass the
# login gate; when unset, the code falls back to a hardcoded demo list so the
# owner is never locked out. Real deployments SHOULD set this in secrets:
# SUPER_ADMINS=admin@yourgov.in

# --- Optional: Neon keep-alive pinger interval in seconds (0 disables) ---
KEEPALIVE_INTERVAL=45

# --- Face-match embedding model (app/face_match.py). Unset => whole-image
#     perceptual dHash via Pillow (works on Vercel today, coarse). Point at an
#     ArcFace/FaceNet-style .onnx + install onnxruntime (local/worker only)
#     for production-grade document-portrait vs live-frame comparison.
#     Local: FACE_EMBED_MODEL=data/models/w600k_r50.onnx (ArcFace, 174 MB) ---
FACE_EMBED_MODEL=

# --- Optional: AI tampering-detector backends (server/worker only) ---
# Blank provider => local heuristic. Sightengine needs a key pair; self-hosted
# needs onnxruntime plus a model cache outside the Vercel bundle.
# AI_DETECTOR_PROVIDER=
# AI_DETECTOR_KEY=
# AI_DETECTOR_ENDPOINT=
# AI_DETECTOR_MODEL_URL=
# AI_DETECTOR_MODEL_DIR=

# --- Optional: local YOLO ROI model path (worker only) ---
# Drop an ID-card detector ONNX here or point at your own file. On machines
# with app/models/card.onnx present it auto-loads that (single-class 'Card'
# detector, 640x640 in -> [1,5,8400] out, ~0.99 mAP50). Never commit weight
# files: app/models/ and data/models/ are gitignored. Trained locally with
# scripts/train_yolo.py on the RTX 4060.
# YOLO_ROI_ONNX_PATH=app/models/card.onnx

# Optional: 5-class Aadhaar field detector (Name/DOB/Gender/Aadhaar_No/Photo).
# Leveraged by yolo_roi.extract_aadhaar_fields for the national-ID OCR route.
# AADHAAR_FIELDS_ONNX_PATH=app/models/aadhaar_fields.onnx